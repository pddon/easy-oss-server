# =============================================================================
# 发布名称 / 地址的唯一配置源。
# 用法：复制本文件内容前先替换 __XXX__ 占位符；或设置同名环境变量（环境变量优先）。
# 改完后运行 python scripts/release/apply-names.py 把值同步到各清单与文档。
# 本文件使用 KEY=value 的简单格式，不要加引号、不要写 shell 表达式。
# =============================================================================

# GitHub 仓库归属（拿到最终仓库地址后替换）
GITHUB_ORG=pddon
GITHUB_REPO=easy-oss-server

# Docker Hub 命名空间（镜像名固定为 <namespace>/oss-server）
DOCKERHUB_NAMESPACE=__DOCKER_HUB_NAMESPACE__

# 安全报告邮箱
SECURITY_CONTACT=service@pddon.com

# Maven Central 的 staging 地址（Sonatype / Central Portal 二选一，按账号实际地址替换）
MAVEN_CENTRAL_STAGING_URL=__MAVEN_CENTRAL_STAGING_URL__

# 包名（拿到最终名字后在这里改，并运行 apply-names.py）
CRATE_NAME=oss-s3-client
NPM_JS_NAME=oss-s3-client
NPM_TS_NAME=@pddon/oss-s3-client
PYPI_NAME=oss-s3-client
MAVEN_GROUP_ID=com.pddon.oss
MAVEN_ARTIFACT_ID=oss-client

# 发布版本（留空则由各脚本从清单读取；打 tag / 推 Docker 时建议显式设置）
VERSION=0.1.0

# PyPI 上传目标：testpypi（默认，安全）或 pypi
PYPI_TARGET=testpypi
