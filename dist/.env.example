# ============================================================
# OSS Server deployment configuration.
# Copy this file to .env and edit it before first deployment:
#     cp .env.example .env
#
# ASCII-only on purpose: old docker-compose (Python) on a
# non-UTF-8 locale cannot parse non-ASCII files. Full Chinese
# descriptions for every variable are in DEPLOY.md section 4.
# Never commit a real .env to version control.
# ============================================================

# ---------- Deployment / container ----------
# Host port exposed to users. The container always listens on 8080.
OSS_PORT=8080
# Image name and tag, generated by build.sh / build.ps1.
OSS_IMAGE=oss-server:latest
# Container name.
OSS_CONTAINER_NAME=oss-server
# Host-visible data directory, mounted to /data (objects + redb metadata).
OSS_DATA_HOST_DIR=./data

# ---------- Required security settings ----------
# Admin UI / admin API token. Change it to a long random string.
OSS_ADMIN_TOKEN=change-me-admin-token
# Master key for encrypting app secrets. Changing it later makes
# existing secrets undecryptable; keep it backed up.
OSS_MASTER_KEY=change-me-master-key

# ---------- Network / public URL ----------
# Public base URL used for signed URLs (set the real external URL
# when running behind a reverse proxy).
OSS_PUBLIC_BASE_URL=http://localhost:8080
# Signed URL lifetime in seconds.
OSS_SIGNATURE_EXPIRE_SECONDS=900
# Maximum upload size in bytes (default 10 GB).
OSS_MAX_UPLOAD_SIZE=10737418240
# Metadata LRU cache size in bytes, 0 disables the cache.
OSS_CACHE_SIZE_BYTES=67108864

# ---------- Storage backend ----------
# redb (default, single-node file database) | memory (tests only) | mysql
OSS_STORAGE_BACKEND=redb
# redb:  redb:///data/oss.db
# mysql: mysql://user:password@host:3306/db
#        (password characters @ : / must be percent-encoded)
OSS_DB_URL=redb:///data/oss.db

# ---------- Trash / cleanup / startup self-check ----------
# Trash retention in days. Expired objects are purged by the cleanup
# task. <=0 disables automatic purging.
OSS_TRASH_RETENTION_DAYS=30
# Cleanup interval in minutes. 0 disables the scheduled task
# (manual trigger in the admin UI still works).
OSS_CLEANUP_INTERVAL_MINUTES=30
# Max objects/records processed per cleanup run.
OSS_CLEANUP_MAX_OBJECTS=1000
# Max seconds per cleanup run.
OSS_CLEANUP_MAX_SECONDS=60
# Startup consistency check mode: report (report only) | fix (repair).
OSS_STARTUP_CHECK_MODE=report
# Nonce retention in seconds; older nonces are purged by cleanup.
OSS_NONCE_RETENTION_SECONDS=3600

# ---------- CORS ----------
# Enable CORS: true / false.
OSS_CORS_ENABLED=false
# Comma-separated allowed origins, used when OSS_CORS_ENABLED=true.
OSS_CORS_ALLOWED_ORIGINS=

# ---------- Build options ----------
# Set to mysql when building the image with the MySQL backend.
CARGO_FEATURES=
# Log level: error / warn / info / debug / trace.
RUST_LOG=info

# ---------- Backup ----------
# Host directory for backup.sh output.
BACKUP_DIR=./backups

# ---------- Optional built-in MySQL (see docker-compose.yml) ----------
# OSS_MYSQL_HOST_DIR=./mysql-data
# MYSQL_ROOT_PASSWORD=rootpass
# MYSQL_DATABASE=oss
# MYSQL_USER=oss
# MYSQL_PASSWORD=password
